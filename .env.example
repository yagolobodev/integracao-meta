# ---------------------------------------------------------------------------
# Kommo CTWA Middleware — variáveis de ambiente
# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Veja o README.md para instruções detalhadas de onde obter cada valor.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Banco de dados -----------------------------------------------------------
# Fallback local (SQLite, zero setup). O caminho é relativo a server/prisma/
# (onde fica schema.prisma), então isto resolve para server/prisma/dev.db.
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL via Prisma) — troque o provider em prisma/schema.prisma
# para "postgresql" e use algo como:
# DATABASE_URL="postgresql://user:password@host:5432/kommo_ctwa?schema=public"

# --- Meta / WhatsApp Cloud API ------------------------------------------------
# App Secret do App da Meta (Configurações do app > Básico > Chave secreta do app)
META_APP_SECRET=
# Token arbitrário que você escolhe e usa ao registrar o webhook na Meta
META_VERIFY_TOKEN=troque-por-um-token-secreto
# Token de acesso permanente (System User) com permissão de business_management /
# whatsapp_business_messaging, usado para chamar a Conversions API
META_CAPI_TOKEN=
# ID da página do WhatsApp Business (Page ID do número do WhatsApp Business)
META_PAGE_ID=
# ID do dataset de Conversions API (Events Manager > Fonte de dados > CAPI Gateway/Dataset)
META_DATASET_ID=
# Código de teste do Test Events (Events Manager > Testar eventos) — opcional
META_TEST_EVENT_CODE=
# Versão da Graph API usada nas chamadas
META_GRAPH_API_VERSION=v21.0

# --- Kommo --------------------------------------------------------------------
# Subdomínio da sua conta Kommo (https://SEU_SUBDOMINIO.kommo.com)
KOMMO_SUBDOMAIN=
# Token de acesso (integração longa duração ou OAuth) com escopo de leads/contacts
KOMMO_ACCESS_TOKEN=
# ID do campo customizado (em Leads) onde o ctwa_clid será gravado
KOMMO_CTWA_FIELD_ID=
# ID do pipeline padrão usado para criar leads novos (opcional)
KOMMO_PIPELINE_ID=

# --- Painel / segurança --------------------------------------------------------
# Segredo usado para assinar eventos internos de teste (não obrigatório)
INTERNAL_API_KEY=
